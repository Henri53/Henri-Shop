# Postgres connection string. Free option: neon.tech -> create project -> copy the
# connection string (turn "Connection pooling" OFF in the copy dialog).
# The same value goes into Vercel -> Settings -> Environment Variables.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Your ONLY owner login. Not stored in the database — checked directly against
# these two values, so nobody else can register or log in as the owner.
# Put your real values only here, never in any code file, never in a chat.
OWNER_EMAIL="you@example.com"
OWNER_PASSWORD="choose-a-strong-password"

# PayPal (developer.paypal.com → Apps & Credentials → create an app).
# Use PAYPAL_ENV=sandbox with a sandbox app while testing (fake money),
# then switch to a live app + PAYPAL_ENV=live for real payments.
PAYPAL_ENV="sandbox"
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
# Same value as PAYPAL_CLIENT_ID — NEXT_PUBLIC_ vars are exposed to the browser,
# which is fine: a PayPal client id is meant to be public, the secret never is.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=""

# Protects /api/cron/check-topups from being triggered by randoms.
# Generate with: openssl rand -base64 24
CRON_SECRET="replace-with-another-long-random-string"
