datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// role/status are plain strings (no database enums), so they are easy to extend:
// User.role: "CUSTOMER" | "OWNER" (OWNER is never actually stored — see lib/auth.ts)
// Topup.status: "PENDING" | "APPROVED" | "REJECTED"
// Order.status: "PAID" | "DELIVERED" | "CANCELLED"

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         String   @default("CUSTOMER")
  balanceCents Int      @default(0)
  createdAt    DateTime @default(now())
  orders       Order[]
  topups       Topup[]
}

model Product {
  id              String   @id @default(cuid())
  name            String
  category        String
  description     String
  longDescription String
  priceCents      Int
  stock           Int      @default(0)
  origin          String
  deliveryTime    String
  warrantyTime    String
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  orders          Order[]

  // Added for the redesign. Both are optional/defaulted, so existing rows stay valid.
  imageUrl        String?
  featured        Boolean  @default(false)
  stockItems      StockItem[]
}

// One deliverable per row (a key, a code, a login...). When a product has any
// stock items, every purchase hands the buyer that many unsold rows instantly
// and Product.stock always equals the number of unsold rows.
model StockItem {
  id        String    @id @default(cuid())
  productId String
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  content   String
  orderId   String?
  order     Order?    @relation(fields: [orderId], references: [id])
  soldAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([productId, orderId])
}

model Order {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  productId    String
  product      Product  @relation(fields: [productId], references: [id])
  qty          Int
  totalCents   Int
  status       String   @default("PAID")
  createdAt    DateTime @default(now())

  // Manual delivery text the owner writes for products without stock items.
  deliveryNote String?
  items        StockItem[]
}

model Topup {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  amountCents Int
  method      String // "PayPal" | "BTC" | "LTC" | "SOL"
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())

  // Crypto auto-detection: a frozen, slightly-randomised target amount
  // and the address it must arrive at, checked by the cron job.
  coin          String?
  cryptoAmount  String?
  address       String?
  txId          String?  @unique
  expiresAt     DateTime?

  // PayPal auto-capture
  paypalOrderId String?  @unique
}
